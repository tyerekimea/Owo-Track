PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:5173 (the Vite dev server) if unset.
CORS_ORIGIN=http://localhost:5173

# Whether the session cookie requires HTTPS. Leave unset/false for local
# dev over http://localhost. Set to true once deployed behind HTTPS —
# browsers will silently drop a Secure cookie sent over plain http.
COOKIE_SECURE=false
