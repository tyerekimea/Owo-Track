PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:5173 (the Vite dev server) if unset.
CORS_ORIGIN=http://localhost:5173

# Firebase Admin credentials — required to start the server.
# FIREBASE_SERVICE_ACCOUNT_JSON is the full service-account key JSON as a
# single-line string. Keep it secret; never commit a real value.
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
