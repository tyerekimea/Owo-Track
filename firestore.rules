rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function sameOrganization(orgId) {
      return signedIn() && userDoc().organization_id == orgId;
    }

    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow update: if signedIn() && (uid == request.auth.uid || isAdmin());
    }

    match /organizations/{orgId} {
      allow read: if sameOrganization(orgId);
      allow write: if isAdmin() && sameOrganization(orgId);

      match /teams/{teamId} {
        allow read: if sameOrganization(orgId);
        allow write: if isAdmin() && sameOrganization(orgId);
      }

      match /budgets/{category} {
        allow read: if sameOrganization(orgId);
        allow write: if isAdmin() && sameOrganization(orgId);
      }

      match /expenses/{expenseId} {
        allow read: if sameOrganization(orgId)
          && (isAdmin()
              || (userDoc().role == 'manager' && resource.data.team_id == userDoc().team_id)
            || resource.data.user_id == request.auth.uid);
        allow create: if sameOrganization(orgId)
            && request.resource.data.organization_id == orgId
            && request.resource.data.user_id == request.auth.uid;
        allow update: if sameOrganization(orgId)
            && request.resource.data.organization_id == orgId
            && request.resource.data.user_id == resource.data.user_id
          && (isAdmin()
            || resource.data.user_id == request.auth.uid
            || (userDoc().role == 'manager' && resource.data.team_id == userDoc().team_id));
        allow delete: if sameOrganization(orgId)
          && resource.data.user_id == request.auth.uid
          && resource.data.status == 'draft';

        match /approvalHistory/{historyId} {
          allow read: if sameOrganization(orgId);
          allow write: if sameOrganization(orgId)
            && (isAdmin() || userDoc().role == 'manager');
        }
      }
    }
  }
}
